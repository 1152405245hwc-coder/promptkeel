{
  "schema": "forge.profile/v1",
  "version": "0.1.0",
  "prompt": {
    "core": "core.md"
  },
  "model": "local",
  "id": "hermes",
  "name": "Hermes",
  "host": "hermes",
  "support": "experimental",
  "capabilities": {
    "prompt": "experimental",
    "approval": "unsupported",
    "sandbox": "unsupported",
    "tools": "experimental",
    "rollback": "experimental"
  },
  "targets": [
    {
      "kind": "yaml-merge",
      "path": ".hermes/config.yaml",
      "scope": "user",
      "value": {
        "agent": {
          "system_prompt": "{{PROMPT}}"
        }
      }
    },
    {
      "kind": "markdown-block",
      "path": ".hermes/SOUL.md",
      "scope": "user",
      "blockId": "forge"
    },
    {
      "kind": "markdown-block",
      "path": ".hermes.md",
      "scope": "project",
      "blockId": "forge"
    }
  ],
  "risk": "high",
  "mutatesHost": true,
  "requiresRestart": true,
  "activationEvidence": [
    "config"
  ]
}
