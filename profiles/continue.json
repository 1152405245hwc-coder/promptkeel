{
  "schema": "forge.profile/v1",
  "id": "continue",
  "name": "Continue agent override + project rules",
  "version": "0.1.0",
  "host": "continue",
  "support": "experimental",
  "prompt": {
    "core": "core.md"
  },
  "capabilities": {
    "prompt": "verified",
    "approval": "unsupported",
    "sandbox": "unsupported",
    "tools": "unsupported",
    "rollback": "verified"
  },
  "targets": [
    {
      "kind": "yaml-merge",
      "path": ".continue/config.yaml",
      "scope": "project",
      "value": {
        "chatOptions": {
          "baseAgentSystemMessage": "{{PROMPT}}"
        }
      }
    },
    {
      "kind": "markdown-block",
      "path": ".continue/rules/dsh-forge.md",
      "scope": "project",
      "blockId": "system"
    }
  ],
  "model": "gpt",
  "risk": "medium",
  "mutatesHost": true,
  "requiresRestart": false,
  "activationEvidence": [
    "config",
    "session"
  ]
}
