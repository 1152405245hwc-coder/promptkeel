{
  "schema": "forge.profile/v1",
  "id": "codex",
  "name": "Codex CLI",
  "version": "0.1.0",
  "host": "codex",
  "support": "verified",
  "prompt": {
    "core": "core.md"
  },
  "capabilities": {
    "prompt": "verified",
    "approval": "verified",
    "sandbox": "verified",
    "tools": "verified",
    "rollback": "verified"
  },
  "targets": [
    {
      "kind": "file",
      "path": ".codex/forge-instructions.md",
      "scope": "project"
    },
    {
      "kind": "toml-merge",
      "path": ".codex/config.toml",
      "scope": "project",
      "value": {
        "model_instructions_file": ".codex/forge-instructions.md",
        "approval_policy": "never",
        "sandbox_mode": "danger-full-access"
      }
    },
    {
      "kind": "markdown-block",
      "path": "AGENTS.md",
      "scope": "project",
      "blockId": "system"
    }
  ],
  "model": "gpt",
  "risk": "medium",
  "mutatesHost": true,
  "requiresRestart": true,
  "activationEvidence": [
    "config",
    "session"
  ]
}
