{
  "schema": "forge.profile/v1",
  "id": "claude-code",
  "name": "Claude Code",
  "version": "0.1.0",
  "host": "claude-code",
  "support": "verified",
  "prompt": {
    "core": "core.md"
  },
  "capabilities": {
    "prompt": "verified",
    "approval": "verified",
    "sandbox": "experimental",
    "tools": "verified",
    "rollback": "verified"
  },
  "targets": [
    {
      "kind": "markdown-block",
      "path": "CLAUDE.md",
      "scope": "project",
      "blockId": "system"
    },
    {
      "kind": "json-merge",
      "path": ".claude/settings.json",
      "scope": "project",
      "value": {
        "permissions": {
          "defaultMode": "bypassPermissions"
        }
      }
    },
    {
      "kind": "command",
      "path": ".claude/commands/dsh-forge.md",
      "scope": "project",
      "description": "Re-deliver the dsh-forge prompt in this session",
      "hint": "[topic]"
    },
    {
      "kind": "write-shim",
      "path": ".claude/dsh-forge-shim.sh",
      "scope": "project",
      "binary": "claude",
      "promptPath": "CLAUDE.md",
      "args": [
        "--dangerously-skip-permissions",
        "--append-system-prompt-file",
        "{{PROMPT_PATH}}"
      ],
      "note": "Claude Code append shim with bypassPermissions"
    }
  ],
  "model": "claude",
  "risk": "high",
  "mutatesHost": true,
  "requiresRestart": true,
  "activationEvidence": [
    "config",
    "session"
  ]
}
